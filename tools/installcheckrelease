#!/usr/bin/perl -w
# Check that the packages staged for release are installable against what
# Slowroll users actually have, before they get promoted out of $sloreleasing.
#
# Candidates come from cache/installcheck/pending/*.solv, written by
# tools/releasestagingone while it still has the binaries downloaded.
#
# usage: tools/installcheckrelease [refresh|check|report|run]
#   refresh  download/convert the base+update environment solvs, then stop
#   check    refresh, then dump raw installcheck output
#   report   check + parse, print offenders - no side effects
#   run      (default) report, then act according to $INSTALLCHECK
#
# env: INSTALLCHECK=warn|enforce|off (default warn), DRYRUN=0 to really act,
#      DEBUG=1 to echo every command that gets run
# needs: libsolv-tools (installcheck rpms2solv rpmmd2solv dumpsolv)

use strict;
use lib 'lib';
use common;
use rpm;

our $mode = $ENV{INSTALLCHECK} || 'warn'; # warn | enforce | off
our $dryrun = ($ENV{DRYRUN}//1) != 0;
our $arch = $ENV{arch} || 'x86_64';
our $maxrounds = 5;

our $cachedir = 'cache/installcheck';
our $pendingdir = "$cachedir/pending";
our $checkstatus = 0; # wait status of the last installcheck run

our %repo = (
    base   => 'https://download.opensuse.org/slowroll/repo/oss/',
    update => 'https://download.opensuse.org/update/slowroll/repo/oss/',
);

sub run($)
{ my $cmd = shift;
    diag("+ $cmd");
    return system($cmd);
}

# tools/getprimary only re-downloads when repomd.xml changed, but it keeps
# every hashed primary it ever fetched. Drop the ones we no longer link to.
sub prune_old_primaries($$)
{ my ($dir, $current) = @_;
    my $keep = (stat($current))[1] or return;
    for my $f (glob("$dir/*-primary.xml.*")) {
        next if (stat($f))[1] == $keep;
        diag("pruning stale $f");
        unlink($f);
    }
}

sub refresh()
{
    for my $name (sort keys %repo) {
        my $dir = "$cachedir/$name";
        system('mkdir', '-p', $dir) == 0 or die "cannot create $dir\n";
        # same idiom as tools/diffdistro. getprimary is sh -x and wget is
        # chatty, so keep that out of the release log unless we want it.
        my $quiet = $ENV{DEBUG} ? '' : ' 2>/dev/null';
        run("d=\$(pwd) ; cd $dir && \$d/tools/getprimary $repo{$name}$quiet") == 0
            or die "getprimary failed for $name\n";
        my ($primary) = glob("$dir/primary.xml.*");
        die "no primary.xml.* in $dir\n" unless $primary && -e $primary;
        prune_old_primaries($dir, $primary);
        my $solv = "$dir/repo.solv";
        next if -e $solv && (stat($solv))[9] >= (stat($primary))[9];
        run(decompressor($primary)." -dc $primary | rpmmd2solv > $solv.new") == 0
            or die "converting $primary failed\n";
        rename("$solv.new", $solv) or die "error writing $solv : $!";
    }
}

sub pending_solvs()
{
    my @solvs = sort glob("$pendingdir/*.solv");
    return @solvs; # in scalar context this is the count, unlike a bare sort
}

sub status2str($)
{ my $s = shift;
    return "could not be run" if $s == -1;
    return "killed by signal ".($s & 127) if $s & 127;
    return "exit ".($s >> 8);
}

sub check()
{
    # installcheck takes any number of repos to check before --nocheck, so we
    # can hand it the candidates directly instead of mergesolv'ing them first
    my @cmd = ('installcheck', $arch, pending_solvs(), '--nocheck',
               map { "$cachedir/$_/repo.solv" } sort keys %repo);
    diag("+ @cmd");
    # fork by hand so we get stderr too - a solv it cannot read is reported
    # there, and we want that in the complaint below rather than lost
    my $pid = open(my $fh, '-|');
    die "fork: $!" unless defined($pid);
    if(!$pid) {
        open(STDERR, '>&', \*STDOUT);
        exec(@cmd);
        die "installcheck: $!";
    }
    local $/=undef;
    my $out = <$fh>;
    close($fh);
    $checkstatus = $?;
    return $out//'';
}

# binary name -> source package, recorded from %{disturl} by releasestagingone
sub load_map()
{
    my %bin2src;
    for my $f (glob("$pendingdir/*.map")) {
        for my $line (split("\n", load_file($f))) {
            my ($bin, $disturl) = split(' ', $line, 2);
            next unless defined($bin) && defined($disturl);
            my $pkg = disturl2pkg($disturl);
            if(!defined($pkg)) {
                diag("unparsable disturl for $bin: $disturl");
                next;
            }
            $bin2src{$bin} = $pkg;
        }
    }
    return \%bin2src;
}

sub load_exceptions()
{
    my $f = 'in/installcheck-exceptions';
    return {} unless -e $f;
    return load_list_map($f);
}

# installcheck reports binary NVRAs; resolve them by longest-prefix match
# against the binary names we know, so no assumption is needed about what
# version and release strings may contain.
sub parse_problems($$)
{ my ($out, $bin2src) = @_;
    my @names = sort { length($b) <=> length($a) } keys %$bin2src;
    my %problem;
    my $cur;
    for my $line (split("\n", $out)) {
        if($line =~ m/^can't install (\S+):$/) {
            my $nvra = $1;
            $cur = undef;
            my ($bin) = grep { $nvra eq $_ || index($nvra, "$_-") == 0 } @names;
            if(!defined($bin)) {
                diag("installcheck reported unknown binary $nvra");
                next;
            }
            $cur = $bin2src->{$bin};
            $problem{$cur} = '' unless exists $problem{$cur};
        } elsif(defined($cur) && $line =~ m/^\s+(\S.*)$/) {
            $problem{$cur} ||= $1;
        }
    }
    return \%problem;
}

sub report()
{
    my $out = check();
    my $problems = parse_problems($out, load_map());

    # installcheck says non-zero whenever it found something. If it did and we
    # recognised none of it, our parsing is wrong or a solv was unreadable -
    # either way we cannot vouch for this release, so make it impossible to
    # miss instead of quietly reporting nothing.
    if($checkstatus && !%$problems) {
        print STDERR "XX installcheck ".status2str($checkstatus).
            " but no problem was recognised - installcheckrelease needs a look.\n".
            "XX its output was:\n$out";
    } elsif(!$checkstatus && %$problems) {
        print STDERR "XX installcheck exited 0 yet we parsed ".
            scalar(keys %$problems)." problem(s) - installcheckrelease needs a look.\n";
    }

    my $exc = load_exceptions();
    my @bad;
    for my $pkg (sort keys %$problems) {
        if($exc->{$pkg}) {
            diag("ignoring $pkg (in in/installcheck-exceptions)");
            next;
        }
        # stderr: releasestaging reads our stdout, and make release tees 2>&1
        print STDERR "XX installcheck rejected $pkg: ".($problems->{$pkg} || 'not installable')."\n";
        push @bad, $pkg;
    }
    return @bad;
}

sub reject($)
{ my $pkg = shift;
    my $prj = $ENV{sloreleasing} or die "sloreleasing is not set\n";
    foreach($prj, $pkg) { die 'invalid char in sanity check' if m/[^a-zA-Z0-9:._+-]/ }
    if($dryrun) {
        print STDERR "echo osc_delete /source/$prj/$pkg\n";
    } else {
        run(qq!. tools/osc.sh ; osc_delete "/source/$prj/$pkg?force=1&comment=installcheck"!);
        # put it back in the queue - it will be retried once the missing
        # dependency has been submitted too
        open(my $t, '>>', "out/pending/$pkg") or die "error writing out/pending/$pkg : $!";
        close($t);
    }
    # drop it from the candidate set either way, so the loop below terminates
    unlink("$pendingdir/$pkg.solv");
    unlink("$pendingdir/$pkg.map");
}

my $cmd = shift || 'run';
exit 0 if $mode eq 'off';

if($cmd eq 'refresh') { refresh(); exit 0 }
exit 0 unless pending_solvs(); # nothing staged, nothing to check

if($cmd eq 'check') { refresh(); print check(); exit 0 }
if($cmd eq 'report') { refresh(); report(); exit 0 }
if($cmd ne 'run') {
    print "usage: $0 [refresh|check|report|run]\n";
    exit 1;
}

refresh();
for my $round (1..$maxrounds) {
    last unless pending_solvs();
    my @bad = report();
    last unless @bad;
    last unless $mode eq 'enforce';
    for my $pkg (@bad) {
        reject($pkg);
        print "$pkg\n"; # releasestaging drops these from $releasedpkgs
    }
    # removing a package can break another one in the same batch, so re-check
    diag("round $round rejected ".scalar(@bad)." package(s), re-checking");
}
