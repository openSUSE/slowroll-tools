#!/usr/bin/perl -w
# usage: echo "message body" | SUBJECT="New Slowroll update 20240830 released!" TOADDR=factory@lists.opensuse.org $0
# MAILER can point somewhere other than mailx - e.g. a mock receiver in tests

$ENV{SUBJECT} or die;
$ENV{TOADDR} ||= 'bernhard+test@lsmod.de';
$ENV{FROMADDR} ||= 'bernhardout@lsmod.de';
$ENV{MAILER} ||= 'mailx';

if($ENV{SILENT}) {
  exit 0; # silence for the moment
}
# list form, so there is no shell to escape the subject for and none of these
# values can inject anything
open(MAILPIPE, "|-", $ENV{MAILER}, "-r", $ENV{FROMADDR}, "-s", $ENV{SUBJECT}, $ENV{TOADDR}) or die;

print MAILPIPE "Please note that this mail was generated by a script.\n\n";

while(<>) {
    print MAILPIPE $_;
}

