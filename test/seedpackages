#!/bin/sh
# Put the test packages into $slobuild the same way production does, so the
# out/pending/ state releasestaging then sees is the real thing.
#
# usage: set -a ; . test/slorc.test ; set +a ; test/seedpackages
. test/guard.sh
set -e

pkgs=$(grep -v '^ *#' test/packages | sed 's/#.*//' | tr -s ' \t' '\n' | grep .)

for p in $pkgs ; do
    echo "== $p"
    # FORCE=1 skips the osc rdiff "is there a diff" probe, which is meaningless
    # against a project that does not have the package yet
    FORCE=1 tools/submitpackageupdate "$p" || echo "XX submit failed for $p"
done

# Kernel module packages need i586 kernel-syms. Production builds them against
# the real Slowroll base, which carries those; the playground base comes from
# Tumbleweed via DoD and does not, so they come out unresolvable on i586 and
# would fail test/waitbuilds for a reason that has nothing to do with the tools.
for p in $pkgs ; do
    grep -qx "$p" in/kmps 2>/dev/null || continue
    echo "== $p: disabling i586 (no kernel-syms in the playground base)"
    # -0777 so the "is it already there" guard sees the whole document - the
    # disable element is on its own line, not on the </package> line, so a
    # per-line guard would insert a duplicate <build> on every rerun
    osc api "/source/$slobuild/$p/_meta" |
        perl -0777 -pe 's{</package>}{  <build><disable arch="i586"/></build>\n</package>} unless m{<disable arch="i586"}' \
        > cache/meta/pkgmeta.tmp
    osc api -X PUT "/source/$slobuild/$p/_meta" --file cache/meta/pkgmeta.tmp >/dev/null
done
rm -f cache/meta/pkgmeta.tmp

# a package that can never be installable, so the installcheck gate has
# something deterministic to reject
canary=slowroll-canary
osc api -X PUT "/source/$slobuild/$canary/_meta" --data \
    "<package project=\"$slobuild\" name=\"$canary\"><title>installcheck canary</title><description/></package>" >/dev/null
osc api -X PUT "/source/$slobuild/$canary/$canary.spec" --file test/pkg/$canary.spec >/dev/null
touch "out/pending/$canary"
echo "== $canary (synthetic, must be rejected by the gate)"

echo
echo "pending: $(ls out/pending/ | wc -l) package(s)"
